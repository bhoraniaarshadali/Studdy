<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/edit_text_background"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/examTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exam Title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/averageScoreTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Average Score: 0"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/highestScoreTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Highest Score: 0"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/lowestScoreTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Lowest Score: 0"
        android:textSize="14sp" />
</LinearLayout>