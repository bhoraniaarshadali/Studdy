<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/edit_text_background"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/examTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exam Title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/durationTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Duration: 60 minutes"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/totalMarksTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Total Marks: 100"
        android:textSize="14sp" />

    <Button
        android:id="@+id/viewSubmissionsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/purple_500"
        android:text="View Submissions"
        android:textColor="@android:color/white" />
</LinearLayout>